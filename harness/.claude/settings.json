{
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(.verify/**)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(REVIEW.md)",
      "Edit(.cursor/rules/**)",
      "Read(.env)",
      "Read(.verify/gate.json)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_gate.py",
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_gate.py",
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit_gate.py",
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
