{
  "locked": [
    ".claude/settings.json",
    ".claude/hooks/",
    ".claude/skills/",
    ".verify/",
    "AGENTS.md",
    "CLAUDE.md",
    "REVIEW.md",
    ".cursor/rules/",
    ".github/workflows/",
    ".github/CODEOWNERS"
  ],
  "test_paths": [
    "**/tests/**",
    "**/*_test.rs",
    "**/test_*.py",
    "**/*_test.py"
  ],
  "checks": [
    {
      "id": "pcmkit-unit",
      "when": ["pcmkit/**/*.rs"],
      "check": "cargo test --manifest-path pcmkit/Cargo.toml --offline --workspace",
      "why": "Rust unit and CLI tests for the running example."
    },
    {
      "id": "pcmkit-oracle",
      "when": ["pcmkit/**/*.rs", "pcmkit/oracle/**"],
      "check": "python3 pcmkit/oracle/test_oracle.py",
      "why": "The CLI must match the Python reference on the same samples."
    },
    {
      "id": "pcmkit-cpp",
      "when": ["pcmkit/crates/pcmkit-ffi/**", "pcmkit/cpp/**", "pcmkit/include/**"],
      "check": "bash pcmkit/cpp/run_consumer.sh",
      "why": "The C ABI is what the C++ consumer actually calls."
    },
    {
      "id": "harness-selftest",
      "when": ["harness/**", "tests/**", "scenarios/**", "labs/**", "tools/**", "briefs/**"],
      "check": "python3 -m unittest discover -s tests -v",
      "why": "Recorded hook events and the cheat corpus must keep failing closed."
    },
    {
      "id": "gain-normalize-accept",
      "when": ["pcmkit/**", "briefs/gain-normalize/**"],
      "check": "python3 briefs/gain-normalize/accept.py",
      "why": "The brief for peak-normalize is done only when its acceptance command exits 0."
    },
    {
      "id": "pcmkit-flaky",
      "when": ["pcmkit/**", "briefs/**"],
      "check": "python3 pcmkit/fast/flaky_scan.py pcmkit briefs",
      "why": "The fast tier rejects sleeps, skips, and retry loops."
    },
    {
      "id": "pcmkit-python",
      "when": ["pcmkit/fast/**", "pcmkit/e2e/**", "pcmkit/oracle/**"],
      "check": "bash pcmkit/fast/python_lint.sh",
      "why": "Ruff and mypy on the Python the fast tier and the end-to-end proof own."
    },
    {
      "id": "pcmkit-tidy",
      "when": ["pcmkit/cpp/**", "pcmkit/include/**"],
      "check": "bash pcmkit/cpp/run_tidy.sh",
      "why": "clang-tidy on the C++ consumer, with the check set the script names."
    },
    {
      "id": "pcmkit-sanitizers",
      "when": ["pcmkit/cpp/**", "pcmkit/crates/pcmkit-ffi/**"],
      "check": "bash pcmkit/cpp/run_sanitizers.sh",
      "why": "AddressSanitizer and UBSan on the C++ side of the ABI."
    },
    {
      "id": "pcmkit-mutation",
      "when": ["pcmkit/oracle/**"],
      "check": "python3 pcmkit/oracle/mutation_smoke.py",
      "why": "A one-mutant smoke: the weak property survives and the differential check does not."
    },
    {
      "id": "pcmkit-e2e",
      "when": ["pcmkit/**"],
      "check": "python3 pcmkit/e2e/prove.py",
      "why": "Normalize and the waveform PNG must match committed bytes, and NOT CHECKED stays explicit."
    },
    {
      "id": "held-out",
      "when": ["tools/heldout/**"],
      "check": "python3 tools/heldout/run.py",
      "why": "Hidden peak cases must fail a checker that only saw non-negative samples."
    },
    {
      "id": "reviewer",
      "when": ["tools/reviewer/**"],
      "check": "python3 tools/reviewer/score.py",
      "why": "The rubric reviewer is scored on the report split, not the tune split."
    },
    {
      "id": "orchestrator",
      "when": ["tools/orchestrator/**"],
      "check": "python3 tools/orchestrator/run.py",
      "why": "Six mocked agents in worktrees, with stale reviews refused."
    },
    {
      "id": "metrics",
      "when": ["tools/metrics/**"],
      "check": "python3 tools/metrics/report.py",
      "why": "Reads per ship, escapes, and a pruner that keeps a catastrophic check."
    },
    {
      "id": "capstone",
      "when": ["tools/capstone/**"],
      "check": "python3 tools/capstone/before_after.py",
      "why": "The same mocked changes, measured before the harness and after it."
    }
  ]
}
